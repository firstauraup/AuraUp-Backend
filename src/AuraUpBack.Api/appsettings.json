{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://www.auraup.org",
      "https://auraup.org"
    ]
  },
  "Media": {
    "EnableThumbnailCaptureFallback": false
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuraUpBack": "jdbc:postgresql://localhost:5432/auraUp-Db",
    "AuraUpBackUsername": "postgres",
    "AuraUpBackPassword": "1803"
  },
  "AdminAuth": {
    "Username": "admin",
    "Email": "admin@auraup.local",
    "Password": "ChangeMe123!",
    "SigningKey": "change-this-signing-key-before-production",
    "TokenLifetimeMinutes": 480,
    "InvitationLifetimeHours": 72,
    "PublicAppUrl": "https://www.auraup.org"
  },
  "Email": {
    "From": "AuraUp <noreply@auraup.org>",
    "ReplyTo": "",
    "PublicAppUrl": "https://www.auraup.org"
  },
  "Instagram": {
    "Provider": "Rpa",
    "ApifyBaseUrl": "https://api.apify.com/v2",
    "ApifyActorId": "apify~instagram-scraper",
    "ApifyApiToken": "",
    "ApifyRequestTimeoutSeconds": 180,
    "CredentialEncryptionKey": "change-this-instagram-credential-key",
    "RpaSessionStatePath": "App_Data/instagram-rpa-session.json",
    "RpaUserDataDirPath": "App_Data/instagram-rpa-profile",
    "RpaHeadless": true,
    "RpaMaxPosts": 0,
    "LoginTimeoutSeconds": 45,
    "LoginTypingDelayMs": 120,
    "ManualInterventionTimeoutSeconds": 300,
    "PreferStoredSession": true,
    "AllowPublicProfileReadWithoutSession": true
  },
  "Transcription": {
    "Provider": "ClipTranscribe",
    "ClipTranscribeBaseUrl": "https://cliptranscribe.com/",
    "RequestTimeoutSeconds": 90,
    "Headless": true
  },
  "Anthropic": {
    "ApiKey": "",
    "BaseUrl": "https://api.anthropic.com/v1/messages",
    "Model": "claude-sonnet-4-20250514",
    "MaxTokens": 16000,
    "RequestTimeoutSeconds": 300
  },
  "AuraUpBack": {
    "DataPath": "App_Data/aura-up-back.json",
    "MonitoringLoopSeconds": 10,
    "DefaultCheckEveryMinutes": 60
  }
}
