{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "AuraUpBack": "jdbc:postgresql://localhost:5432/auraUp-Db",
    "AuraUpBackUsername": "postgres",
    "AuraUpBackPassword": "1803"
  },
  "Instagram": {
    "Provider": "Rpa",
    "ApifyBaseUrl": "https://api.apify.com/v2",
    "ApifyActorId": "apify~instagram-scraper",
    "ApifyApiToken": "",
    "ApifyRequestTimeoutSeconds": 180,
    "CredentialEncryptionKey": "change-this-instagram-credential-key",
    "RpaSessionStatePath": "App_Data/instagram-rpa-session.json",
    "RpaHeadless": true,
    "RpaMaxPosts": 0,
    "LoginTimeoutSeconds": 45,
    "LoginTypingDelayMs": 120,
    "ManualInterventionTimeoutSeconds": 300,
    "PreferStoredSession": true,
    "AllowPublicProfileReadWithoutSession": true
  },
  "Transcription": {
    "Provider": "ClipTranscribe",
    "ClipTranscribeBaseUrl": "https://cliptranscribe.com/",
    "ClipTranscribeSessionStatePath": "App_Data/cliptranscribe-rpa-session.json",
    "ClipTranscribeLoginTimeoutSeconds": 60,
    "RequestTimeoutSeconds": 90,
    "Headless": true
  },
  "AuraUpBack": {
    "DataPath": "App_Data/aura-up-back.json",
    "MonitoringLoopSeconds": 10,
    "DefaultCheckEveryMinutes": 60
  }
}
